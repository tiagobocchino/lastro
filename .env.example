# Copie para .env. Nunca versione o .env.
LASTRO_HOME=.lastro
# Banco da plataforma. Vazio = SQLite em LASTRO_HOME. Produção: URL do pooler do Supabase (modo transação),
# com a senha vinda do Secret Manager, nunca escrita aqui. Requer uv sync --extra postgres.
LASTRO_BANCO_URL=
# Pasta dos arquivos de cada empresa. Vazio = LASTRO_HOME/tenants. Em produção: o bucket montado (ADR 0007).
LASTRO_TENANTS=
LASTRO_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
# Modelo de linguagem (opcional). nenhum = só heurísticas, custo zero.
# ollama (local, grátis) | groq | gemini | outro endpoint compatível com a API da OpenAI
LASTRO_LLM=nenhum
LASTRO_LLM_MODELO=
LASTRO_LLM_URL=
LASTRO_LLM_CHAVE=
# Busca semântica na Caixa (sinônimos: "faturamento" acha "valor_vendido"). Grátis e local.
# Requer: uv sync --extra vetores. O modelo (~240 MB) baixa na primeira execução.
LASTRO_EMBEDDER=nenhum
# local | producao. Em producao, LASTRO_SEGREDO precisa ter 32+ caracteres aleatórios.
LASTRO_AMBIENTE=local
# Limite de upload de fonte, em MB.
LASTRO_UPLOAD_MAX_MB=50
