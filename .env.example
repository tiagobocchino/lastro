# Copie para .env. Nunca versione o .env.
LASTRO_HOME=.lastro
# Banco da plataforma. Vazio = SQLite em LASTRO_HOME. Produção: URL do pooler do Supabase (modo transação),
# com a senha vinda do Secret Manager, nunca escrita aqui. Requer uv sync --extra postgres.
LASTRO_BANCO_URL=
# Pasta dos arquivos de cada empresa. Vazio = LASTRO_HOME/tenants. Em produção: o bucket montado (ADR 0007).
LASTRO_TENANTS=
LASTRO_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
# Modelo de linguagem (opcional). nenhum = só heurísticas, custo zero.
# ollama (local, grátis) | groq | gemini | outro endpoint compatível com a API da OpenAI
LASTRO_LLM=nenhum
LASTRO_LLM_MODELO=
LASTRO_LLM_URL=
LASTRO_LLM_CHAVE=
# Busca semântica na Caixa (sinônimos: "faturamento" acha "valor_vendido"). Grátis e local.
# Requer: uv sync --extra vetores. O modelo (~240 MB) baixa na primeira execução.
LASTRO_EMBEDDER=nenhum
# local | producao. Em producao, LASTRO_SEGREDO precisa ter 32+ caracteres aleatórios.
LASTRO_AMBIENTE=local
# Limite de upload de fonte, em MB.
LASTRO_UPLOAD_MAX_MB=50
# Endereço público do Lastro (volta da autorização OAuth2: <URL>/oauth/retorno). Vazio = o endereço da requisição.
LASTRO_URL_PUBLICA=
# Aplicativos OAuth2 do Lastro em cada sistema (LST-9). Em produção vêm do Secret Manager, nunca deste arquivo.
# Nomes: LASTRO_OAUTH_<SISTEMA>_CLIENT_ID e LASTRO_OAUTH_<SISTEMA>_CLIENT_SECRET, com SISTEMA em
# RDSTATION_CRM, CONTAAZUL, GOOGLE_SHEETS, GOOGLE_DRIVE. Os tokens dos clientes ficam no cofre, não aqui.
LASTRO_OAUTH_CONTAAZUL_CLIENT_ID=
LASTRO_OAUTH_CONTAAZUL_CLIENT_SECRET=
# Segredo do disparo das cargas agendadas (POST /tarefas/cargas, cabeçalho X-Lastro-Tarefa). 32+ caracteres; produção: Secret Manager.
LASTRO_TAREFA_SEGREDO=
# Plano B (ADR 0009): espelho da pasta das empresas no Supabase Storage (LST-30). Vazio = sem espelho.
# A chave é a secreta (sb_secret_...), só no painel do Render; nunca neste arquivo.
LASTRO_STORAGE_URL=
LASTRO_STORAGE_CHAVE=
LASTRO_STORAGE_BUCKET=tenants
